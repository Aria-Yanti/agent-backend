# ===== Agent Playground 环境变量模板 =====
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env

# --- 服务监听 ---
# 后端监听地址（默认本机）
AGENT_PLAYGROUND_HOST=127.0.0.1
# 后端监听端口（默认 8011）
AGENT_PLAYGROUND_PORT=8011
# 前端访问地址（用于 CORS 白名单，本地部署保持 127.0.0.1）
PUBLIC_IP=127.0.0.1

# --- LLM 配置（OpenAI 兼容接口）---
# 必填：API Key，未配置时系统进入无 LLM 的演示 fallback 模式
OPENAI_API_KEY=
# 兼容接口地址，如 https://api.openai.com/v1 或任意 OpenAI 兼容代理
OPENAI_BASE_URL=https://api.openai.com/v1
# 默认模型
OPENAI_MODEL=gpt-4o-mini
# 是否保留 reasoning content（部分兼容代理需要关闭）
PRESERVE_REASONING_CONTENT=true

# --- SkillHub 技能市场（可选）---
SKILLHUB_API_KEY=
SKILLHUB_BASE_URL=https://www.skillhub.club/api/v1
SKILLHUB_TIMEOUT_SECONDS=20

# --- 高级路径（一般无需修改）---
# AGENT_PLAYGROUND_APP_HOME=
# AGENT_PLAYGROUND_BUNDLED_SKILLS_ROOT=
# AGENT_PLAYGROUND_BUNDLED_RUNTIME_ROOT=
# AGENT_PLAYGROUND_ENV_PATH=
